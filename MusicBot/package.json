{
  "name": "kbot-music-console",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors red,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "./serve.sh run",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@lucide/vue": "latest",
    "vue": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "latest",
    "concurrently": "latest",
    "typescript": "~5.9.3",
    "vite": "latest",
    "vue-tsc": "latest"
  }
}
