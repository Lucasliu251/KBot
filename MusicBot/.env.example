# KOOK机器人配置
MUSIC_BOT_TOKEN=your_music_bot_token_here

# FFMPEG配置（可留空让程序从 macOS/Linux PATH 自动发现）
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# 下一首歌曲预解码缓存与实时流缓冲
MUSIC_PRELOAD_SECONDS=600
MUSIC_CACHE_TTL=900
MUSIC_CACHE_MAX_SONGS=3
MUSIC_STREAM_BUFFER_SECONDS=45
MUSIC_STARTUP_BUFFER_SECONDS=8
MUSIC_STARTUP_GRACE_SECONDS=2.5
MUSIC_CONTINUATION_LEAD_SECONDS=90
MUSIC_IDLE_DISCONNECT_SECONDS=3

# 内置网易云 API：由 run.py 自动启动，只允许本机访问，不需要开放防火墙/Nginx。
NETEASE_API_HOST=127.0.0.1
NETEASE_API_PORT=8005
NETEASE_API_MANAGED=True
NETEASE_API_START_TIMEOUT=30
MUSIC_API_BASE=http://127.0.0.1:8005
BACKUP_MUSIC_API=
NETEASE_HOT_PLAYLIST_ID=3778678
# 无持久磁盘时可用环境变量注入网易云完整 Cookie；常规部署请在设置后台扫码。
NETEASE_COOKIE=

# QQ音乐（默认使用网页扫码登录，凭证保存在 data/qqmusic/ 且不会提交 Git）
# 服务器无持久化磁盘时，可改用 QQ_MUSIC_CREDENTIAL_JSON 保存完整 Credential JSON。
QQ_MUSIC_CREDENTIAL_JSON=
QQ_MUSIC_CREDENTIAL_FILE=
QQ_MUSIC_DEVICE_FILE=
QQ_MUSIC_TOP_ID=26
# 可选：mp3_320 / mp3_128 / flac，失败时自动降级到 MP3。
QQ_MUSIC_QUALITY=mp3_320

# Bilibili（匿名公开视频；单视频/分P最长1小时）
BILIBILI_MAX_VIDEO_SECONDS=3600
BILIBILI_EXTRACT_TIMEOUT=30
# 可选：仅包含 Bilibili 登录态的 Netscape cookies.txt，留空使用匿名会话。
BILIBILI_COOKIE_FILE=

# Web控制台配置
SECRET_KEY=change_this_to_a_random_string
# Banner 齿轮设置后台的管理密钥；务必使用独立随机长字符串。
MUSIC_SETTINGS_TOKEN=change_this_to_another_random_string
# “大家推荐”使用 KOOK OAuth 识别推荐者。回调地址必须与 KOOK 开发者后台完全一致。
KOOK_OAUTH_CLIENT_ID=
KOOK_OAUTH_CLIENT_SECRET=
KOOK_OAUTH_REDIRECT_URI=https://your-domain.example/Music/api/auth/kook/callback
# 正式 HTTPS 部署设为 True；本机 HTTP 开发保持 False。
MUSIC_SESSION_COOKIE_SECURE=False
HOST=0.0.0.0
PORT=8004
DEBUG=False
