# Local environment files, including backups and per-machine variants.
.env
.env.*
!.env.example
**/config.ini.*
**/config.json.*
!**/config.ini.example
!**/config.json.example
.serve.log
.serve.pid
.scheduled_tasks.lock
.venv/

# 任意目录下的 Python 缓存
__pycache__/
*.py[cod]

# 仓库根目录没有 package.json；防止在根目录误跑 npm 留下空 lockfile
/package-lock.json

